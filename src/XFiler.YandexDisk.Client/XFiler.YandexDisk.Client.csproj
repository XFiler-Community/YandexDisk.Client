<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
        <Version>9.0.0</Version>
        <Product>Yandex Disk RestAPI Client for .NET</Product>
        <Description>.NET library wrapper of Yandex Desktop RestAPI.
            See https://tech.yandex.ru/disk/
            This is fork with support source gen json and native aot
        </Description>
        <Authors>XFiler Community</Authors>
        <Company>XFiler Community</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/XFiler-Community/YandexDisk.Client</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <Copyright>Copyright (c) 2026 XFiler Community, 2023-2026 Egor Zheludkov, 2015 Yuriy Nagaev</Copyright>
        <PackageTags>yandex, disk, yandex-disk, cloud disk, client, aot</PackageTags>
        <RepositoryUrl>https://github.com/XFiler-Community/YandexDisk.Client.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Nullable>enable</Nullable>
        <PackageId>XFiler.YandexDisk.Client</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Credfeto.Enumeration.Source.Generation" Version="1.1.1.168">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Http\DiskClientBase.Query.cs">
            <DependentUpon>DiskClientBase.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" Visible="false" PackagePath="\" />
    </ItemGroup>

</Project>
