<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Not every protocol member carries an XML comment yet -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>XFiler.YandexDisk.Client</PackageId>
        <Version>9.0.0</Version>
        <Product>Yandex Disk RestAPI Client for .NET</Product>
        <Description>.NET library wrapper of Yandex Desktop RestAPI.
            See https://tech.yandex.ru/disk/
            This is fork with support source gen json and native aot
        </Description>
        <Authors>XFiler Community</Authors>
        <Company>XFiler Community</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/XFiler-Community/YandexDisk.Client</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright (c) 2026 XFiler Community, 2023-2026 Egor Zheludkov, 2015 Yuriy Nagaev</Copyright>
        <PackageTags>yandex, disk, yandex-disk, cloud disk, client, aot</PackageTags>
        <RepositoryUrl>https://github.com/XFiler-Community/YandexDisk.Client.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="YandexDisk.Client.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" Visible="false" PackagePath="\" />
    </ItemGroup>

</Project>
